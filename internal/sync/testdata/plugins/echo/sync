#!/bin/sh
# A fixture plugin: `plan` prints the plan beside this file, `apply` keeps what it was
# handed and says every push went through.
here=$(dirname "$0")
case "$1" in
  plan)  cat "$here/plan.json" ;;
  apply) cat > "$here/applied.json"; echo '{"ok":["n0"],"failed":[]}' ;;
  *) echo "usage: sync plan|apply" >&2; exit 1 ;;
esac
