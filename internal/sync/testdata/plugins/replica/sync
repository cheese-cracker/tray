#!/bin/sh
# A fixture replica: it asked for every row (the all-rows marker beside this file) and
# brings back rows made on another machine, each saying where it sat (plan.json).
here=$(dirname "$0")
case "$1" in
  plan)  cat > "$here/seen.json"; cat "$here/plan.json" ;;
  apply) echo '{"ok":[],"failed":[]}' ;;
  *) echo "usage: sync plan|apply" >&2; exit 1 ;;
esac
